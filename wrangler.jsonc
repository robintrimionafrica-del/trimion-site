{
  // Trimion Africa Shop: static website served by the Cloudflare Worker "trimion-catalog-v123".
  // Every push to main is deployed by Cloudflare Workers Builds (deploy command: npx wrangler deploy).
  // worker/index.js only handles /api/subscribe and the private /subscribers list; everything else is ./public.
  "name": "trimion-catalog-v123",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "SUBSCRIBERS", "class_name": "Subscribers" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Subscribers"] }]
}
